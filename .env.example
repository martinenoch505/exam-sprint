# Copy this file to .env and replace the placeholder. Keep .env private; it is ignored by Git.
# Never put an API key in the browser or commit it to a public repository.
GEMINI_API_KEY=replace_with_your_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
PORT=3000
# Optional for production, comma-separated (for example: https://your-site.example)
# CORS_ORIGIN=
